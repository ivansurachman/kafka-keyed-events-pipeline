# Salin ke .env: cp .env.example .env
# Dipakai oleh Python (src/config.py) DAN docker compose (auto-load .env).

# --- Python client (akses dari host) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092,localhost:29093,localhost:29094
KAFKA_TOPIC=events_topic
KAFKA_GROUP_ID=events_group
PRODUCE_INTERVAL_SEC=5
DB_PATH=output/events.db

# --- Pembuatan topic (docker compose, service kafka-init) ---
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=3
